# Application
APP_NAME=Scholarship Autopilot
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
POSTGRES_USER=scholarship
POSTGRES_PASSWORD=scholarship
POSTGRES_DB=scholarship_autopilot
DATABASE_URL=postgresql+asyncpg://scholarship:scholarship@db:5432/scholarship_autopilot
DATABASE_URL_SYNC=postgresql://scholarship:scholarship@db:5432/scholarship_autopilot

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email (optional for development — logs to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@scholarship-autopilot.local

# Search
SEARCH_PROVIDER=duckduckgo
# BRAVE_API_KEY=  # optional if using Brave Search

# Rate limits
DISCOVER_RATE_LIMIT_PER_HOUR=3

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
